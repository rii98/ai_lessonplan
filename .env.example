# Copy to .env and adjust. These override config/config.yaml.
# Nesting uses double underscores: LF__<SECTION>__<KEY>.

# --- referenced by config/config.yaml interpolation ---
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

