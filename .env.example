# Copy to .env and adjust. These feed config/config.yaml interpolation.
# Nesting overrides use double underscores: LF__<SECTION>__<KEY>.

# --- backends ---
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Postgres: the ONE persistent store ---
DATABASE_URL=postgresql://lessonforge:lessonforge@localhost:5432/lessonforge
# optional separate DDL role for `lessonforge-db migrate` (the app role then needs DML only)
DATABASE_MIGRATE_URL=

# --- Edboox (defaults point at the dev fake on :8200) ---
EDBOOX_ISSUER=http://localhost:8200
EDBOOX_JWKS_URL=http://localhost:8200/.well-known/jwks.json
EDBOOX_LOGIN_URL=http://localhost:8200/login
EDBOOX_WEB_ORIGIN=http://localhost:8200
EDBOOX_API_URL=http://localhost:8200
EDBOOX_API_KEY=dev-edboox-api-key

# --- secrets (generate: python -c "import secrets; print(secrets.token_hex(32))") ---
LF_SESSION_SECRET=
LF_COOKIE_SECURE=true          # false only for plain-http local dev

# --- direct overrides (highest priority) ---
# LF__LLM__MODEL=gemma4:31b-cloud
# LF__CONTEXT__PROVIDER=claims   # no Edboox directory endpoint
