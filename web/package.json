{
  "name": "@lessonforge/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LessonForge web client — React + TypeScript.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../docs/openapi.v1.json -o src/lib/api/schema.d.ts",
    "check:api": "node scripts/check-api.mjs",
    "verify": "npm run check:api && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-popover": "1.1.2",
    "@tanstack/react-query": "5.62.0",
    "clsx": "2.1.1",
    "dompurify": "3.2.0",
    "highlight.js": "11.10.0",
    "immer": "10.1.1",
    "katex": "0.16.11",
    "lucide-react": "0.460.0",
    "markdown-it": "14.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "msw": "2.6.5",
    "openapi-typescript": "7.4.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
